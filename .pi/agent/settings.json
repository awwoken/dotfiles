{
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "lastChangelogVersion": "0.84.2",
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "user-only",
  "branchSummary": {
    "skipPrompt": true
  },
  "packages": [
    "git:git@github.com:hasit/pi-community-themes.git",
    "npm:pi-blackhole",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "git:git@github.com:carderne/pi-sandbox",
    "npm:pi-tool-display",
    "git:git@github.com:calesennett/pi-codex-fast.git"
  ],
  "mcp": {
    "configPath": "mcp.json",
    "prefixTools": true
  },
  "pi-codex-fast": {
    "enabled": false
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "researcher": {
        "disabled": true
      },
      "advisor": {
        "disabled": true
      },
      "worker": {
        "disabled": true
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      },
      "context-builder": {
        "disabled": true
      },
      "planner": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "gpt-pro": {
        "disabled": true
      }
    }
  },
  "theme": "gruvbox-dark-hard"
}
