{
  "enabled": true,
  "allowBrowserProcess": false,
  "network": {
    "allowedDomains": [
      "raw.githubusercontent.com",
      "github.com",
      "*.github.com"
    ],
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      "~/",
      "/var/folders"
    ],
    "allowWrite": [
      "~/.cache",
      ".",
      "/tmp"
    ],
    "denyWrite": [
      "~/dotfiles/.pi/agent/sandbox.json",
      "~/.pi/agent/sandbox.json"
    ]
  }
}
