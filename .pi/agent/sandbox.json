{
  "enabled": true,
  "allowBrowserProcess": false,
  "network": {
    "allowedDomains": [
      "raw.githubusercontent.com",
      "github.com",
      "*.github.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com"
    ],
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      "~/",
      "/tmp",
      "/var/folders"
    ],
    "denyWrite": [
      "~/dotfiles/.pi/agent/sandbox.json",
      "~/.pi/agent/sandbox.json"
    ],
    "allowWrite": [
      "~/",
      "/tmp",
      "/var/folders"
    ]
  }
}
