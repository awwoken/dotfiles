#!/usr/bin/env bash
set -euo pipefail

wrapper_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
binary="${GITHUB_MCP_SERVER_BIN:-$wrapper_dir/github-mcp-server}"

if [ ! -x "$binary" ]; then
  printf 'error: GitHub MCP server was not found at %s\n' "$binary" >&2
  exit 1
fi

if [ -z "${GH_TOKEN:-}" ]; then
  printf 'error: GH_TOKEN is required to start the GitHub MCP server\n' >&2
  exit 1
fi

export GITHUB_PERSONAL_ACCESS_TOKEN="$GH_TOKEN"
unset GH_TOKEN GITHUB_TOKEN
unset SSH_AUTH_SOCK

exec "$binary" stdio
