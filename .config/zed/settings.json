{
  // appearance & theme
  "show_edit_predictions": false,
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "enable_feedback": false,
    "default_profile": "ask",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.4",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "git_panel": {
    "group_by": "staging",
    "dock": "left",
    "tree_view": true,
  },
  "minimum_contrast_for_highlights": 45.0,
  "text_rendering_mode": "platform_default",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "colorize_brackets": true,
  "rounded_selection": true,
  "show_wrap_guides": true,

  // ai assistant
  "disable_ai": true,
  // "agent_servers": {
  //   "codex-acp": {
  //     "type": "registry",
  //   },
  // },
  // "show_edit_predictions": false,
  // "use_system_prompts": true,
  // "use_system_path_prompts": true,

  // editor behavior
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
  },
  "relative_line_numbers": "enabled",
  "redact_private_values": false,
  "auto_indent": "syntax_aware",
  "extend_comment_on_newline": false,
  "tab_size": 2,
  "session": {
    "trust_all_worktrees": true,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 1,
    "line_width": 1,
    "enabled": true,
  },

  // fonts & sizing
  "buffer_font_family": ".ZedMono",
  "buffer_font_features": {
    "calt": false,
  },
  "buffer_font_size": 17.0,

  "ui_font_family": ".ZedSans",
  "ui_font_features": {
    "calt": false,
  },
  "ui_font_size": 17,

  "agent_buffer_font_size": 17.0,
  "agent_ui_font_size": 17.0,

  // ui components
  "title_bar": {
    "show_user_picture": false,
    "show_menus": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "file_icons": false,
    "git_status": true,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "experimental.show": false,
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": true,
    "breadcrumbs": false,
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },

  // panels & tools
  "project_panel": {
    "dock": "left",
    "button": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false,
    "indent_size": 12,
  },
  "terminal": {
    "shell": "system",
    "button": true,
  },
  "search": {
    "center_on_match": true,
    "button": true,
  },
  "debugger": {
    "button": true,
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
    },
  },
  "edit_predictions": {
    "mode": "subtle",
  },

  // language specific
  "languages": {
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-",
          ],
        },
      },
    },
  },
}
