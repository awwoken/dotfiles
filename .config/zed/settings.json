{
  // appearance & theme
  "tab_size": 2,
  "theme": "Zedokai",
  "icon_theme": "Zed (Default)",
  "colorize_brackets": false,
  "rounded_selection": true,
  "show_wrap_guides": true,

  // fonts & sizing
  "buffer_font_family": ".ZedMono",
  "buffer_font_size": 17.0,
  "buffer_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "ui_font_size": 19.0,
  "ui_font_weight": 400.0,
  "agent_buffer_font_size": 17.0,
  "agent_ui_font_size": 18.0,
  "buffer_font_features": {
    "calt": false
  },
  "ui_font_features": {
    "calt": false
  },

  // editor behavior
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "redact_private_values": true,

  // ui components
  "title_bar": {
    "show_user_picture": false,
    "show_menus": false
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": true
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "experimental.show": false
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": true,
    "breadcrumbs": false
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    }
  },

  // panels & tools
  "project_panel": {
    "button": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false
  },
  "terminal": {
    "button": true
  },
  "search": {
    "button": true
  },
  "debugger": {
    "button": true
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true
    }
  },

  // ai assistant
  "agent": {
    "model_parameters": [],
    "enable_feedback": false
  },

  // language specific
  "languages": {
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-"
          ]
        }
      }
    }
  }
}
