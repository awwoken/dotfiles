# Focus windows
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Move windows inside the BSP tree
shift + alt - h : yabai -m window --warp west
shift + alt - j : yabai -m window --warp south
shift + alt - k : yabai -m window --warp north
shift + alt - l : yabai -m window --warp east

# Resize
alt - 0x1B : yabai -m window --resize left:50:0 2>/dev/null || yabai -m window --resize right:-50:0 2>/dev/null
alt - 0x18 : yabai -m window --resize left:-50:0 2>/dev/null || yabai -m window --resize right:50:0 2>/dev/null

# Layout controls
# alt - 0x2C : yabai -m space --layout bsp
# alt - 0x2B : yabai -m space --layout stack
# alt - b : yabai -m space --balance
# alt - t : yabai -m window --toggle float

# Focus numbered Spaces
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

# Focus lettered Spaces
alt - q : yabai -m space --focus q
alt - w : yabai -m space --focus w
alt - e : yabai -m space --focus e
alt - r : yabai -m space --focus r

alt - a : yabai -m space --focus a
alt - s : yabai -m space --focus s
alt - d : yabai -m space --focus d
alt - f : yabai -m space --focus f

alt - z : yabai -m space --focus z
alt - x : yabai -m space --focus x
alt - c : yabai -m space --focus c

# Move window to numbered Spaces
shift + alt - 1 : yabai -m window --space 1
shift + alt - 2 : yabai -m window --space 2
shift + alt - 3 : yabai -m window --space 3
shift + alt - 4 : yabai -m window --space 4
shift + alt - 5 : yabai -m window --space 5

# Move window to lettered Spaces
shift + alt - q : yabai -m window --space q
shift + alt - w : yabai -m window --space w
shift + alt - e : yabai -m window --space e
shift + alt - r : yabai -m window --space r

shift + alt - a : yabai -m window --space a
shift + alt - s : yabai -m window --space s
shift + alt - d : yabai -m window --space d
shift + alt - f : yabai -m window --space f

shift + alt - z : yabai -m window --space z
shift + alt - x : yabai -m window --space x
shift + alt - c : yabai -m window --space c

# Return to previous Space
alt - tab : yabai -m space --focus recent
